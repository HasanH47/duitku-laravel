{
  "name": "duitku/laravel",
  "description": "Duitku Payment Gateway for Laravel",
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "Hasan H",
      "email": "me@hasanh.dev"
    }
  ],
  "require": {
    "php": "^8.2",
    "illuminate/console": "^12.0|^13.0",
    "illuminate/support": "^12.0|^13.0",
    "illuminate/http": "^12.0|^13.0",
    "illuminate/validation": "^12.0|^13.0",
    "illuminate/view": "^12.0|^13.0",
    "guzzlehttp/guzzle": "^7.8"
  },
  "require-dev": {
    "pestphp/pest": "^3.0|^4.0",
    "pestphp/pest-plugin-laravel": "^3.0|^4.0",
    "orchestra/testbench": "^10.0|^11.0",
    "phpstan/phpstan": "^2.3",
    "larastan/larastan": "^3.13",
    "laravel/pint": "^1.27"
  },
  "autoload": {
    "psr-4": {
      "Duitku\\Laravel\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Duitku\\Laravel\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "pest",
    "analyse": "phpstan analyse --memory-limit=512M",
    "format": "pint",
    "format:check": "pint --test"
  },
  "extra": {
    "laravel": {
      "providers": [
        "Duitku\\Laravel\\DuitkuServiceProvider"
      ],
      "aliases": {
        "Duitku": "Duitku\\Laravel\\Facades\\Duitku"
      }
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "config": {
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  }
}
